{
    "update_url": "https://clients2.google.com/service/update2/crx",
    "name": "9Captcha Solver",
    "version": "0.5.6",
    "description": "Fast, automated captcha solving through 9Captcha AI.",
    "content_scripts": [
        {
            "matches": [
                "*://*.hcaptcha.com/captcha/*"
            ],
            "js": [
                "captcha/hcaptcha.js"
            ],
            "run_at": "document_start",
            "all_frames": true
        },
        {
            "matches": [
                "*://9captcha.pridesmp.fun/setup*",
                "*://9captcha-api.pridesmp.fun/setup*"
            ],
            "js": [
                "pages/setup.js"
            ],
            "run_at": "document_end",
            "all_frames": false
        },
        {
            "matches": [
                "*://9captcha.pridesmp.fun/integrate*",
                "*://9captcha-api.pridesmp.fun/integrate*"
            ],
            "js": [
                "pages/integrate.js"
            ],
            "run_at": "document_end",
            "all_frames": true
        },
        {
            "matches": [
                "*://*.hcaptcha.com/captcha/*"
            ],
            "include_globs": [
                "*frame=challenge*"
            ],
            "js": [
                "captcha/hook.js"
            ],
            "all_frames": true,
            "run_at": "document_end",
            "world": "MAIN"
        }
    ],
    "icons": {
        "16": "icon/16.png",
        "32": "icon/32.png",
        "48": "icon/48.png",
        "128": "icon/128.png"
    },

    "manifest_version": 3,
    "permissions": [
        "debugger",
        "declarativeNetRequest",
        "storage",
        "scripting"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "action": {
        "default_title": "9Captcha: CAPTCHA Solver",
        "default_icon": "icon/16.png",
        "default_popup": "popup.html"
    },
    "host_permissions": [
        "<all_urls>"
    ],

    "minimum_chrome_version": "100.0",
    "version_name": "v0.5.6",
    "short_name": "9Captcha"
}