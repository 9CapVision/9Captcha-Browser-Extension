{
  "name": "9Captcha: CAPTCHA Solver",
  "version": "0.6.1",
  "description": "AI Solver for hCAPTCHA through 9Captcha.",
  "permissions": [
    "scripting",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.hcaptcha.com/captcha/*"
      ],
      "js": [
        "assets/cursor_hook.js",
        "assets/3j6q82.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://localhost/setup*",
        "*://9captcha-api.pridesmp.fun/setup*"
      ],
      "js": [
        "assets/9c_setup.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "assets/loomo6.js"
      ],
      "run_at": "document_end",
      "match_about_blank": true,
      "all_frames": true
    }
  ],
  "icons": {
    "16": "/icon/16.png",
    "32": "/icon/32.png",
    "48": "/icon/48.png",
    "128": "/icon/128.png"
  },
  "manifest_version": 2,
  "background": {
    "scripts": [
      "assets/cursor_bg.js",
      "assets/tvvkm8.js"
    ]
  },
  "browser_action": {
    "default_title": "9Captcha: CAPTCHA Solver",
    "default_popup": "assets/9c_popup.html",
    "default_icon": {
      "16": "/icon/16.png",
      "32": "/icon/32.png",
      "48": "/icon/48.png",
      "128": "/icon/128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{9ca9fc8a-f1f0-4b7e-a8d2-3c5e7f1a9b0d}",
      "strict_min_version": "100.0"
    }
  }
}